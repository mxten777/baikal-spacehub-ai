# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: YouTube Data API v3 (for fetching video metadata)
VITE_YOUTUBE_API_KEY=

# Optional: Instagram Basic Display API access token
VITE_INSTAGRAM_ACCESS_TOKEN=

# ─── SEO / Search Console Verification ───────────────────────────────────────
# Google Search Console: Settings > Ownership verification > HTML tag
# Copy only the "content" value from the <meta> tag
VITE_GOOGLE_SITE_VERIFICATION=

# Naver Search Advisor: 사이트 추가 > HTML 태그 > content 값만 복사
VITE_NAVER_SITE_VERIFICATION=

# Bing Webmaster Tools: Verify > XML / Meta tag > content 값만 복사
VITE_BING_SITE_VERIFICATION=
